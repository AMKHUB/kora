# Toutes les clés API et accès base de données restent exclusivement côté serveur (/api/* et server.js).
# Aucune clé API ni variable VITE_* n'est exposée dans le code front-end.
PORT=3000
SITE_URL=https://kora.example
# Analytics sans cookie (Plausible). Laisser vide pour désactiver.
PLAUSIBLE_DOMAIN=
# Supabase (lu uniquement côté serveur par server/supabaseServer.js et api/*)
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
# Mode de facturation côté serveur : 'simulation' (activation gratuite pour tests) | 'live' (paiement obligatoire)
BILLING_MODE=simulation
# Cloudflare R2 (stockage vidéo grande capacité jusqu'à 5 Go/film + bande passante 0 €)
R2_ACCOUNT_ID=13542688dd607875e5a443ef3b10643e
R2_BUCKET_NAME=kora-videos
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_PUBLIC_BASE_URL=
# SasPay (https://api.saspay.me/api/v1 — encaissement Mobile Money & Carte, retraits, webhooks)
# Clé API SasPay (sk_test_... en développement, sk_live_... en production) — jamais dans le front-end ni dans Git
SASPAY_API_KEY=
# Secret de signature du webhook SasPay (affiché une seule fois à la création dans app.saspay.me)
SASPAY_WEBHOOK_SECRET=
# URL publique exacte de l'application (https://, sans / final)
APP_URL=https://kora-five-xi.vercel.app
