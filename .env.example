# Toutes les clés API et accès base de données restent exclusivement côté serveur (/api/* et server.js).
# Aucune clé API ni variable VITE_* n'est exposée dans le code front-end.
PORT=3000
SITE_URL=https://kora.example
# Analytics sans cookie (Plausible). Laisser vide pour désactiver.
PLAUSIBLE_DOMAIN=
# Supabase (lu uniquement côté serveur par server/supabaseServer.js et api/*)
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
# Mode de facturation côté serveur : 'simulation' (activation gratuite pour tests) | 'live' (paiement obligatoire)
BILLING_MODE=simulation
