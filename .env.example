# Aucune clé secrète n'est lue par le front-end : tout passe par server.js ou les Edge Functions Supabase
PORT=3000
SITE_URL=https://kora.example
# Analytics sans cookie (Plausible). Laisser vide pour désactiver.
PLAUSIBLE_DOMAIN=
# Supabase (clé publishable : publique par conception, protégée par les règles RLS)
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
# Mode de facturation : 'simulation' (activation gratuite pour tests) | 'live' (paiement obligatoire en production)
VITE_BILLING_MODE=simulation
